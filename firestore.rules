rules_version = '2';

/**
 * FIRESTORE SECURITY RULES - PROTOTYPING MODE
 * 
 * Simplified to ensure all authenticated users have full administrative access.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn();
    }

    // --- Collection Rules ---

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn() && request.auth.uid == adminUid;
      allow list, create, update, delete: if false;
    }

    match /members/{memberId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /chitRounds/{roundId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow list, get, create: if isAdmin();
      allow update, delete: if false;
    }

    match /monthLocks/{lockId} {
      allow list, get, create, update, delete: if isAdmin();
    }

    match /cycles/{cycleId} {
      allow list, get, create, update, delete: if isAdmin();
    }

    match /monthlyTargets/{targetId} {
      allow list, get, create, update, delete: if isAdmin();
    }
    
    match /systemMetadata/{docId} {
      allow get, list, create, update, delete: if isAdmin();
    }
  }
}